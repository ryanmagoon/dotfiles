# chezmoi pattern file (target paths, not source paths).
# Anything listed here will NOT be applied to $HOME when `chezmoi apply` runs,
# and also excluded from `chezmoi re-add`.

# Repo-level docs — these live only in the git working tree, never in $HOME.
README.md
AGENTS.md
CONTEXT.md
LICENSE
.github
.github/**
docs
docs/**

# Claude Code runtime directories — these are state, not config.
# Never let these get swept into the repo.
.claude/sessions
.claude/sessions/**
.claude/backups
.claude/backups/**
.claude/projects
.claude/projects/**
.claude/shell-snapshots
.claude/shell-snapshots/**
.claude/session-env
.claude/session-env/**

# Codex runtime state and credentials — these are state, not config.
# auth.json holds OAuth tokens; NEVER let it near the repo (it's public).
.codex/auth.json
.codex/sessions
.codex/sessions/**
.codex/sqlite
.codex/sqlite/**
.codex/tmp
.codex/tmp/**
.codex/log
.codex/log/**
.codex/history.jsonl
.codex/models_cache.json
.codex/.codex-global-state.json
.codex/.personality_migration
.codex/vendor_imports
.codex/vendor_imports/**
.codex/skills/.system
.codex/skills/.system/**

# Skills-installer lockfile that lives in the repo working tree (written by
# the mattpocock/skills installer run from the repo root) — not a dotfile,
# never apply it to $HOME.
skills-lock.json

# Local per-machine overrides that should never be synced.
.claude/*.local.json
.claude/settings.local.json
